{
 "dependencies": {},
 "description": "Yourkly on Cloudflare Artifacts: version control for people (and agents) who never hear the word git.",
 "devDependencies": {
  "esbuild": "^0.21.0"
 },
 "license": "MIT",
 "name": "yourkly-artifacts",
 "scripts": {
  "build": "node scripts/build-assets.js && esbuild src/worker.js --bundle --format=esm --platform=browser --outfile=dist/worker.js --external:cloudflare:* --external:node:*",
